# ============================================================================
# MODÜL — MULTI-TENANT COMMERCIAL SAAS & BİRİM TENANT #1 ORTAM DEĞİŞKENLERİ
# ============================================================================

# --- 1. Supabase PostgreSQL & Force-RLS Bağlantısı ---
NEXT_PUBLIC_SUPABASE_URL=https://gmxzpwufdsjtwzshxomd.supabase.co
# Yeni nesil Supabase API anahtarları (önerilen):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# (Eski nesil JWT anahtar kullanıyorsanız NEXT_PUBLIC_SUPABASE_ANON_KEY ve SUPABASE_SERVICE_ROLE_KEY de desteklenir)
# Canlı SaaS tablolarına (`modul_*`) doğrudan PostgREST yazımını etkinleştirmek için:
MODUL_ALLOW_LIVE_SAAS_POSTGREST=false

# --- 2. Birim Mobilya A.Ş. (Tenant #1) Varsayılan Organizasyon & Şube ---
BIRIM_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
BIRIM_DEFAULT_BRANCH_ID=8407bbdf-c03d-4aba-bcfc-17ef28c54d63
# Not: Kardeş `F:/birim-portal/.env.local` okuma mekanizması yalnızca Tenant #1 (Birim)
# yerel geliştirme ortamında çalışır; dış SaaS kiracıları için otomatik kilitlidir.
BIRIM_DISABLE_PORTAL_ENV_FALLBACK=false

# --- 3. Çok Kiracılı SaaS Oturum, Güvenlik ve Teklif İmzalama Anahtarları ---
MODUL_SAAS_SESSION_SECRET=degistirin-en-az-32-karakter-kriptografik-oturum-sirri
BIRIM_QUOTE_SIGNING_SECRET=degistirin-en-az-32-karakter-teklif-hmac-sirri
# Canlı çok kiracılı SaaS yayında tüm API rotalarında zorunlu oturum jetonu aramak için:
MODUL_SAAS_REQUIRE_AUTH=false
# Sunucu yerel yedek defter dizini (isteğe bağlı):
# MODUL_SAAS_DATA_DIR=/var/lib/modul-saas

# --- 4. Cloudflare R2 İzole Depolama (`<tenantId>/configurator/...`) ---
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=birim-web-staging
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_R2_DOMAIN=https://pub-xxxx.r2.dev
BIRIM_SHARE_PORTAL_R2=true

# --- 5. Dış Firma ERP HMAC Webhook ve Bulut GPU Render Ayarları ---
MODUL_WEBHOOK_SIGNING_SECRET=whsec_degistirin_dis_erp_hmac_imza_sirri
MODUL_CLOUD_SAAS_MODE=false
MODUL_ALLOW_LOCAL_BLENDER_SPAWN=false

# --- 6. Ticari Abonelik ve Ödeme Sağlayıcıları (İyzico TR & Stripe Global) ---
IYZICO_API_KEY=sandbox-iyzico-api-key
IYZICO_SECRET_KEY=sandbox-iyzico-secret-key
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
