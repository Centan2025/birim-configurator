# ============================================================================
# BİRİM CONFIGURATOR V7.5 — SUPABASE RPC & ORTAK BİRİM-PORTAL CLOUDFLARE R2
# ============================================================================
# NOT: Geliştirme ortamında `F:\birim-portal\.env.local` veya `.env.staging.local`
# mevcutsa `birim-configurator` aşağıdaki R2_* ve SUPABASE_* anahtarlarını
# otomatik olarak `birim-portal` üzerinden okur (tekrar kopyalamanız gerekmez).
# Farklı bir yol belirtmek isterseniz:
# BIRIM_PORTAL_ENV_PATH=F:/birim-portal/.env.local

NEXT_PUBLIC_SUPABASE_URL=https://gmxzpwufdsjtwzshxomd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

BIRIM_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
BIRIM_DEFAULT_BRANCH_ID=8407bbdf-c03d-4aba-bcfc-17ef28c54d63

# Ortak Birim-Portal Cloudflare R2 (lib/r2.ts ile birebir aynı değişken adları)
# Tüm yüklemeler `${orgId}/configurator/...` öneki altına izole edilir.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=birim-web-staging
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_R2_DOMAIN=https://pub-xxxx.r2.dev

# Ortak canlı Birim-Portal R2 bucket (`birim-teklif` / `birim-web`) kullanımı için:
BIRIM_SHARE_PORTAL_R2=true
